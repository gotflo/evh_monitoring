# Types des fichiers de l'application installable (le manifeste etait servi en texte brut).
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType text/javascript .js
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # LiteSpeed (Hostinger) : ne pas interrompre PHP une fois la reponse envoyee. Sans cela,
    # le travail fait apres la reponse (envoi des notifications push) est coupe net.
    <IfModule LiteSpeed>
        RewriteRule .* - [E=noabort:1,E=noconntimeout:1]
    </IfModule>

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Pages de l'application (React) : le fichier index.html est servi directement, sans
    # demarrer Laravel (plus rapide, et aucun processus PHP occupe pour un fichier statique).
    # Seules les adresses sans extension, hors /api, /up et /storage, sont concernees.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !(^|/)(api|up|storage)(/|$)
    RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,8}$
    RewriteRule ^ index.html [L]

    # Fichier absent (ancien JS apres une mise a jour, image supprimee...) : vrai 404.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !(^|/)(api|up)(/|$)
    RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]{1,8}$
    RewriteRule ^ - [R=404,L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Page d'accueil servie directement (index.html), Laravel pour le reste.
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    # En-tetes de securite aussi sur les fichiers statiques (Laravel les pose sur l'API).
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    <FilesMatch "\.html$">
        Header always set X-Frame-Options "DENY"
        # Toujours reverifie : une nouvelle version est vue des le chargement suivant.
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Fichiers du build dont le nom change a chaque version : gardes un an par le navigateur.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# Compression (si le CDN ne l'a pas deja faite).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
