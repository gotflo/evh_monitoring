APP_NAME="Console My vasesdhonneur"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5174
APP_TIMEZONE=America/Toronto
APP_LOCALE=fr

# Base de la console (ses propres donnees : acces, audit, incidents, rapports, reglages).
DB_CONNECTION=sqlite
# DB_DATABASE=/chemin/absolu/vers/database.sqlite

# Base de la plateforme My vasesdhonneur (lecture des mesures et des comptes).
APP_DB_CONNECTION=sqlite
APP_DB_DATABASE=/chemin/absolu/vers/evh_platform/backend/database/database.sqlite

# Plateforme supervisee et secret partage (meme valeur que MONITOR_AGENT_SECRET de la plateforme).
PLATFORM_URL=http://127.0.0.1:8000
MONITOR_AGENT_SECRET=

# Codes de connexion : en local, le code s'affiche a l'ecran.
SMS_DRIVER=log

CONSOLE_OWNER_PHONE=+14187181876
CONSOLE_SESSION_HOURS=12

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
MAIL_MAILER=log

# Localite des connexions (ville, region, pays) : ipwhois (defaut, HTTPS, sans cle) | ipapi | none.
# Les adresses IP publiques des connexions sont envoyees au service choisi.
GEOIP_PROVIDER=ipwhois
# Pays habituels : une connexion d'un membre depuis un autre pays ouvre un incident.
MONITOR_HOME_COUNTRIES=CA
