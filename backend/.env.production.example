# ============================================================
#  Console de supervision - configuration de PRODUCTION
#  A copier en .env sur le serveur. Remplacer les valeurs entre < >.
#  Ne jamais versionner le vrai .env.
# ============================================================

APP_NAME="Console My vasesdhonneur"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Adresse exacte du sous-domaine de la console (avec https).
APP_URL=https://<console.vasesdhonneurchicoutimi.org>
APP_TIMEZONE=America/Toronto
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# --- Base de la console (MySQL, creee dans hPanel) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_console>
DB_USERNAME=<u123456789_console>
DB_PASSWORD=<mot_de_passe_base_console>

# --- Base de la plateforme (lecture des mesures, des comptes et de l'audit) ---
# Memes valeurs que DB_* dans le .env de la plateforme.
APP_DB_CONNECTION=mysql
APP_DB_HOST=localhost
APP_DB_PORT=3306
APP_DB_DATABASE=<u123456789_evh>
APP_DB_USERNAME=<u123456789_evh>
APP_DB_PASSWORD=<mot_de_passe_base_plateforme>

# --- Plateforme supervisee ---
PLATFORM_URL=https://<espace.vasesdhonneurchicoutimi.org>
# Secret partage : 32 caracteres ou plus, IDENTIQUE a MONITOR_AGENT_SECRET de la plateforme.
# Generer par exemple avec : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
MONITOR_AGENT_SECRET=<secret_partage>
PLATFORM_TIMEOUT=10
PLATFORM_SLOW_HEALTH_MS=3000

# --- Connexion a la console : code par SMS (Twilio Verify) ---
# Memes identifiants que la plateforme possibles (ou un service Verify dedie).
SMS_DRIVER=twilio_verify
TWILIO_ACCOUNT_SID=<AC...>
TWILIO_API_KEY_SID=<SK...>
TWILIO_API_KEY_SECRET=<secret_cle_api>
TWILIO_VERIFY_SERVICE_SID=<VA...>
TWILIO_VERIFY_TEMPLATE_SID=
EXPOSE_OTP=false

# --- Acces ---
CONSOLE_OWNER_PHONE=+14187181876
CONSOLE_SESSION_HOURS=12

# --- Conservation par defaut (jours), modifiable ensuite dans la console ---
MONITOR_RETENTION_DAYS=30
MONITOR_METRICS_RETENTION_DAYS=90
CONSOLE_AUDIT_RETENTION_DAYS=365

# --- Canaux d'alerte facultatifs (le canal « application » fonctionne sans reglage) ---
# Courriel (identifiants SMTP de la boite creee dans hPanel) :
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=<alertes@vasesdhonneurchicoutimi.org>
# MAIL_PASSWORD=<mot_de_passe_boite>
# MAIL_FROM_ADDRESS=<alertes@vasesdhonneurchicoutimi.org>
# MAIL_FROM_NAME="Console My vasesdhonneur"
# MONITOR_ALERT_EMAILS=<adresse1@exemple.org,adresse2@exemple.org>
# Webhook entrant (adresse secrete) :
# MONITOR_ALERT_WEBHOOK_URL=<https://hooks.slack.com/services/...>
# MONITOR_ALERT_WEBHOOK_FORMAT=slack

MONITOR_VULNERABILITY_CHECK=true

# --- Fichiers et journaux ---
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info

# Localite des connexions (ville, region, pays) : ipwhois (defaut, HTTPS, sans cle) | ipapi | none.
# Les adresses IP publiques des connexions sont envoyees au service choisi.
GEOIP_PROVIDER=ipwhois
# Pays habituels : une connexion d'un membre depuis un autre pays ouvre un incident.
MONITOR_HOME_COUNTRIES=CA
